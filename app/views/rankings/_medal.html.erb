<% case index %>
  <% when 1 %>
    <span class="material-icons md-48 bg-gradient-to-r from-yellow-300 via-yellow-500 to-yellow-600 text-gradient">
      military_tech
    </span>
  <% when 2 %>
    <span class="material-icons md-48 bg-gradient-to-r from-gray-300 via-gray-400 to-gray-500 text-gradient">
      military_tech
    </span>
  <% when 3 %>
    <span class="material-icons md-48 bg-gradient-to-r from-amber-500 via-yellow-700 to-yellow-800 text-gradient">
      military_tech
    </span>
  <% else %>
    <span class="material-icons md-48 bg-gradient-to-r from-sky-100 via-sky-200 to-sky-300 text-gradient">
      military_tech
    </span>
<% end %>